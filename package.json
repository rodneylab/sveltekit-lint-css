{
	"name": "sveltekit-lint-css",
	"version": "0.0.1",
	"license": "BSD-3-Clause",
	"description": "SvelteKit CSS Stylelint: how you can lint vanilla CSS within your Svelte source files using stylelint accessibility and best practice rules.",
	"scripts": {
		"dev": "vite dev",
		"start": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-check",
		"lint": "prettier --check --plugin prettier-plugin-svelte --plugin @trivago/prettier-plugin-sort-imports . && eslint .",
		"lint:css": "stylelint \"src/**/*.{css,svelte}\"",
		"format": "prettier --ignore-path .gitignore --write --plugin prettier-plugin-svelte --plugin @trivago/prettier-plugin-sort-imports .",
		"prettier:check": "prettier --check --plugin=prettier-plugin-svelte --plugin @trivago/prettier-plugin-sort-imports ."
	},
	"devDependencies": {
		"@commitlint/config-conventional": "latest",
		"@eslint/js": "^9.31.0",
		"@fontsource/hind": "^5.2.6",
		"@fontsource/montserrat": "^5.2.6",
		"@sveltejs/kit": "^2.25.2",
		"@sveltejs/vite-plugin-svelte": "^6.1.0",
		"@trivago/prettier-plugin-sort-imports": "^5.2.2",
		"commitlint": "^19.8.1",
		"eslint": "^9.31.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.11.0",
		"globals": "^16.3.0",
		"husky": "^9.1.7",
		"postcss-html": "^1.8.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"stylelint": "^16.22.0",
		"stylelint-config-recommended": "^16.0.0",
		"stylelint-config-standard": "^38.0.0",
		"svelte": "^5.36.16",
		"svelte-check": "^4.3.0",
		"typescript-eslint": "^8.38.0",
		"vite": "^7.0.6"
	},
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/rodneylab/sveltekit-lint-css"
	},
	"bugs": {
		"url": "https://github.com/rodneylab/sveltekit-lint-css/issues"
	},
	"peerDependencies": {
		"vite": "^3.0.5"
	}
}
